{
  "name": "@stadline/react-vectormap",
  "version": "0.3.0",
  "license": "MIT",
  "repository": "alex-pex/jvectormap",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "unpkg": "dist/index.umd.js",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "default": "./dist/index.esm.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "cd .. && cross-env BABEL_ENV=production bili --root-dir react-vectormap",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist/*"
  ],
  "dependencies": {
    "jquery": "^4.0.0",
    "jvectormap-next": "^3.2.0",
    "prop-types": "^15.6.0"
  },
  "devDependencies": {
    "jvectormap-content": "^0.2.0"
  },
  "peerDependencies": {
    "react": ">=16.0.0"
  }
}
